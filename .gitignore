# Data — fetched at runtime, never committed (data/README.md explains how)
data/*
!data/README.md

# Per-query predictions — kept local; the committed run evidence lives in results/
preds/

# Training outputs, merged models, quantized artifacts — except the small
# run-provenance files re-included below (loss history, resolved config)
outputs/*
!outputs/qlora_run
outputs/qlora_run/*
!outputs/qlora_run/log_history.json
!outputs/qlora_run/resolved_config.yaml
models/
*.gguf
*.sqlite
*.bin
*.safetensors

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/
*.egg-info/

# Secrets / environment
.env

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
